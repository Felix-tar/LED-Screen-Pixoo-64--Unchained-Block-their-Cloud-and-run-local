[Unit]
Description=pixoo-local bootstrap Device/InitV2 [NATIVE mode - not used with Docker]
After=network-online.target
Wants=network-online.target

[Service]
User=pixoo-local
Group=pixoo-local
EnvironmentFile=/etc/pixoo-local/pixoo-local.env
WorkingDirectory=/opt/pixoo-local
ExecStart=/opt/pixoo-local/.venv/bin/python -m bootstrap.app
Restart=on-failure
RestartSec=3
# bind port 80 as a non-root user
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RuntimeDirectory=pixoo
ReadWritePaths=/opt/pixoo-local/reports /run/pixoo

[Install]
WantedBy=multi-user.target
