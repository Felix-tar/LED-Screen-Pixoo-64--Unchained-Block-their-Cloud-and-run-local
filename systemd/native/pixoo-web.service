[Unit]
Description=pixoo-local web UI + REST API [NATIVE mode - not used with Docker]
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
User=pixoo-local
Group=pixoo-local
EnvironmentFile=/etc/pixoo-local/pixoo-local.env
WorkingDirectory=/opt/pixoo-local
# In native mode the web process also runs the supervisor thread (shared API).
ExecStart=/opt/pixoo-local/.venv/bin/python -m web.app
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RuntimeDirectory=pixoo
ReadWritePaths=/opt/pixoo-local/reports /run/pixoo

[Install]
WantedBy=multi-user.target
