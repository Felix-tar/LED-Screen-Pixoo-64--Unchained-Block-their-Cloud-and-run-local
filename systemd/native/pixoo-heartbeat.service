[Unit]
Description=pixoo-local MQTT heartbeat responder [NATIVE mode - not used with Docker]
After=network-online.target mosquitto.service
Wants=network-online.target
Requires=mosquitto.service

[Service]
User=pixoo-local
Group=pixoo-local
EnvironmentFile=/etc/pixoo-local/pixoo-local.env
WorkingDirectory=/opt/pixoo-local
ExecStart=/opt/pixoo-local/.venv/bin/python -m mqtt.heartbeat
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RuntimeDirectory=pixoo
ReadWritePaths=/run/pixoo

[Install]
WantedBy=multi-user.target
