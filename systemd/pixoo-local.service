# Primary unit for the Docker/macvlan deployment. Ensures the macvlan network
# + container are up at boot (belt-and-suspenders alongside the container's
# restart=unless-stopped policy) and gives systemctl control of the whole stack.
# Installed + enabled by scripts/install.sh.
[Unit]
Description=pixoo-local (Divoom Pixoo 64 local bootstrap + control stack, Docker macvlan)
Documentation=file:/opt/pixoo-local/README.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/pixoo-local
# Build is done once by install.sh; boot only (re)starts the stack.
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
ExecReload=/usr/bin/docker compose up -d
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
